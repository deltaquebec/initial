%% DESCRIPTION
%% 
%% comprehensive package for creating decorative initial letters 
%% in LaTeX. 
%% 
%% Derived from novel.cls and lettrine.sty, but fully standalone.
%%
%% USAGE
%% 
%% \usepackage{initial}
%% \initial[<options>]{<letter>}[<text>]
%%
%% OPTIONS
%% --
%% geometry
%%   lines=<int>          : lines initial spans vertically [default: 3]
%%   depth=<int>          : extra lines reserved below initial [default: 0]
%%   scale=<float>        : overall size multiplier [default: 1]
%%   hstretch=<float>     : horizontal stretch factor [default: 1]
%%   vstretch=<float>     : vertical stretch factor [default: 1]
%%   basecap=<bool>       : size to base cap-height (allow diacritic overflow)
%%
%% position
%%   hoffset=<dim>        : horizontal shift (negative moves into margin)
%%   voffset=<dim>        : vertical shift (positive raises)
%%   grid=<bool>          : round vertical space to nearest baseline multiple
%%
%% paragraph shaping (region 1, 2)
%%   findent=<dim>        : gap between initial and first line
%%   nindent=<dim>        : gap between initial and subsequent lines
%%   gap=<dim>            : additive shift applied to both findent/nindent
%%   slope=<dim>          : per-line indent increment (for diagonal letters)
%%
%% after-region (region 3)
%%   afterlines=<int>     : if >0, enables shaping for lines after initial
%%   afterindent=<dim>    : base indentation for after-region
%%   afterslope=<dim>     : per-line increment for after-region
%%
%% styling, content:
%%   color=<name>         : color of initial
%%   font=<cmd>           : font switching command (e.g., \sffamily)
%%   bold, italic, ...    : style toggles (smallcaps, slanted)
%%   contour=<bool>       : enable contour outline
%%   contourcolor=<name>  : color of outline [default: white]
%%   contoursize=<dim>    : width of outline stroke [default: 0.3pt]
%%   actualtext=<str>     : replacement text for PDF accessibility
%%   box=<bool>           : draw bounding box for debugging
%%
%% ante, post text
%%   ante=<text>          : marginal text before initial (scaled)
%%   ante*=<text>         : marginal text before initial (unscaled/body size)
%%   post=<style>         : styling for trailing optional arg (e.g., textsc)
%%
%% clearance
%%   tclearance=<dim>     : fixed space added above paragraph
%%   bclearance=<dim>     : fixed space added below paragraph
%%   textlines=<int>      : paragraph line count (auto-calculates bottom space)
%%
%% presets 
%%   preset=<name|int>    : apply named preset or legacy numeric (1-6)
%%
%% COMMANDS
%% ---
%% \initial[opts]{char}[post] : typeset an initial letter
%% \newinitial{name}{opts}    : define a reusable preset bundle
%%
%% DEPENDENCIES
%% --
%% xparse, keyval, xstring, ifthen, graphicx, calc, etoolbox, xcolor, contour
%%
%% 

