% compute target height (ems of baseline grid)
\def\initial@getheight{%
	\@tempdima=\baselineskip
	\setlength{\initial@height}{\value{initial@lines}\@tempdima}%
	\addtolength{\initial@height}{-\@tempdima}%
	\ifinitial@basecap
		\sbox{\initial@normalXbox}{X}%
	\else
		\ifthenelse{\equal{\initial@actualchar}{}}{%
			\sbox{\initial@normalXbox}{X}%
		}{%
			\sbox{\initial@normalXbox}{\initial@actualchar}%
		}%
	\fi
	\addtolength{\initial@height}{\ht\initial@normalXbox}%
	\setlength{\initial@height}{\initial@scale\initial@height}%
}

% typeset glyph at computed height
\newcommand*{\initial@char}{%
	\initial@getheight
	\ifinitial@basecap
		\def\@initialtestchar{X}%
	\else
		\ifthenelse{\equal{\initial@actualchar}{}}{%
			\def\@initialtestchar{X}%
		}{%
			\def\@initialtestchar{\initial@actualchar}%
		}%
	\fi
	\sbox{\@tempboxa}{%
		\initial@font
		\initial@charstyle
		\fontsize{\initial@height}{\initial@height}\selectfont \@initialtestchar%
	}%
	\@tempcntb=\ht\@tempboxa
	\@tempcnta=\initial@height
	\multiply\@tempcnta by 100
	\divide\@tempcntb by 100
	\divide\@tempcnta by \@tempcntb
	\advance\@tempcnta by -9999
	\ifnum\@tempcnta>0
	\edef\@initialscale{1.\the\@tempcnta}%
	\else
	\def\@initialscale{1}%
	\fi
	\initial@font
	\initial@charstyle
	\fontsize{\@initialscale\initial@height}{\@initialscale\initial@height}\selectfont
}

% scale ante to match initial
\newcommand*{\initial@scaleante}[1]{%
	\begingroup
	\initial@getheight
	\sbox{\@tempboxa}{X}%
	\@tempdima=\ht\@tempboxa
	\@tempdimb=0.7\initial@height
	\@tempcnta=\@tempdimb
	\@tempcntb=\@tempdima
	\multiply\@tempcnta by 100
	\divide\@tempcnta by \@tempcntb
	\ifnum\@tempcnta<100
	\def\@antefinalscale{1}%
	\else
	\count@=\@tempcnta
	\divide\count@ by 100
	\edef\@anteint{\the\count@}%
	\multiply\count@ by 100
	\advance\@tempcnta by -\count@
	\ifnum\@tempcnta<10
	\edef\@antefinalscale{\@anteint.0\the\@tempcnta}%
	\else
	\edef\@antefinalscale{\@anteint.\the\@tempcnta}%
	\fi
	\fi
	\scalebox{\@antefinalscale}{#1}%
	\endgroup
}

% apply color and contour
\newcommand*{\initial@applycolor}[1]{%
	\ifinitial@contour
	\contourlength{\initial@contoursize}%
	\ifdefempty{\initial@color}{%
		\contour{\initial@contourcolor}{#1}%
	}{%
		\textcolor{\initial@color}{\contour{\initial@contourcolor}{#1}}%
	}%
	\else
	\ifdefempty{\initial@color}{%
		#1%
	}{%
		\textcolor{\initial@color}{#1}%
	}%
	\fi
}

% apply post styling
\newcommand*{\initial@applypost}[2]{%
	\begingroup
	\@tempswafalse
	\IfSubStr{#1}{none}{\@tempswatrue}{}%
	\IfSubStr{#1}{normal}{\@tempswatrue}{}%
	\if@tempswa
	#2%
	\else
	\IfSubStr{#1}{textsc}{\scshape}{}%
	\IfSubStr{#1}{textbf}{\bfseries}{}%
	\IfSubStr{#1}{textit}{\itshape}{}%
	\IfSubStr{#1}{texttt}{\ttfamily}{}%
	\IfSubStr{#1}{textsl}{\slshape}{}%
	#2%
	\fi
	\endgroup
}

% framed box for debugging
\DeclareDocumentCommand \initial@boxcap { m }{%
	\begingroup
	\setlength\fboxsep{0pt}%
	\setlength\fboxrule{0.4pt}%
	\sbox{\@tempboxa}{#1}%
	\fcolorbox{red}{white}{\usebox{\@tempboxa}}%
	\endgroup
}

% named preset factory (see TeXtured for example factory building)
\newcommand*{\newinitial}[2]{%
	\expandafter\def\csname initial@preset@#1\endcsname{#2}%
}

% option keys
\define@key{initial}{lines}{\setcounter{initial@lines}{#1}}
\define@key{initial}{depth}{\setcounter{initial@depth}{#1}}
\define@key{initial}{hoffset}{\setlength{\initial@hoffset}{#1}}
\define@key{initial}{voffset}{\setlength{\initial@voffset}{#1}}
% ante: hanging, scaled
\define@key{initial}{ante}{%
	\renewcommand*{\initial@anteraw}{#1}%
	\initial@antehangingtrue
	\initial@antescaledtrue
}
% ante*: hanging, unscaled
\define@key{initial}{ante*}{%
	\renewcommand*{\initial@anteraw}{#1}%
	\initial@antehangingtrue
	\initial@antescaledfalse
}
\define@key{initial}{gap}{\setlength{\initial@GapShift}{#1}}
\define@key{initial}{findent}{\setlength{\initial@Findent}{#1}}
\define@key{initial}{nindent}{\setlength{\initial@NindentGap}{#1}}
\define@key{initial}{hstretch}{\renewcommand*{\initial@hstretch}{#1}}
\define@key{initial}{vstretch}{\renewcommand*{\initial@vstretch}{#1}}
\define@key{initial}{scale}{\renewcommand*{\initial@scale}{#1}}
\define@key{initial}{slope}{\setlength{\initial@slope}{#1}}
\define@key{initial}{afterlines}{\setcounter{initial@afterlines}{#1}}
\define@key{initial}{afterindent}{\setlength{\initial@afterindent}{#1}}
\define@key{initial}{afterslope}{\setlength{\initial@afterslope}{#1}}
\define@key{initial}{box}[true]{%
	\ifthenelse{\equal{#1}{true}}{\initial@showboxtrue}{\initial@showboxfalse}%
}
\define@key{initial}{color}{\def\initial@color{#1}}
\define@key{initial}{post}{\def\initial@post{#1}}
\define@key{initial}{preset}{%
	\ifnum\value{initial@presetdepth}>5\relax
		\PackageError{initial}{preset recursion limit exceeded (circular reference?)}{}%
	\else
		\stepcounter{initial@presetdepth}%
		\@ifundefined{initial@preset@#1}{%
			\setcounter{initial@presettype}{#1}%
			\initial@applypresettrue
		}{%
			\begingroup
			\edef\x{\endgroup
				\noexpand\setkeys{initial}{\csname initial@preset@#1\endcsname}}%
			\x
		}%
	\fi
}
\define@key{initial}{textlines}{\setcounter{initial@textlines}{#1}}
\define@key{initial}{bclearance}{\setlength{\initial@bclearance}{#1}}
\define@key{initial}{tclearance}{\setlength{\initial@tclearance}{#1}}
\define@key{initial}{grid}[true]{%
	\ifthenelse{\equal{#1}{true}}{\initial@gridtrue}{\initial@gridfalse}%
}
\define@key{initial}{font}{\def\initial@font{#1}}
\define@key{initial}{bold}[true]{%
	\ifthenelse{\equal{#1}{true}}{\initial@boldtrue}{\initial@boldfalse}%
}
\define@key{initial}{italic}[true]{%
	\ifthenelse{\equal{#1}{true}}{\initial@italictrue}{\initial@italicfalse}%
}
\define@key{initial}{smallcaps}[true]{%
	\ifthenelse{\equal{#1}{true}}{\initial@smallcapstrue}{\initial@smallcapsfalse}%
}
\define@key{initial}{slanted}[true]{%
	\ifthenelse{\equal{#1}{true}}{\initial@slantedtrue}{\initial@slantedfalse}%
}
\define@key{initial}{contour}[true]{%
	\ifthenelse{\equal{#1}{true}}{\initial@contourtrue}{\initial@contourfalse}%
}
\define@key{initial}{contourcolor}{\def\initial@contourcolor{#1}}
\define@key{initial}{contoursize}{\setlength{\initial@contoursize}{#1}}
\define@key{initial}{actualtext}{\def\initial@actualtext{#1}}
\define@key{initial}{basecap}[true]{%
	\ifthenelse{\equal{#1}{true}}{\initial@basecaptrue}{\initial@basecapfalse}%
}

% detect image by extension
\def\initial@isimage#1{%
	\@tempswafalse
	\IfSubStr{#1}{.pdf}{\@tempswatrue}{}%
	\IfSubStr{#1}{.PDF}{\@tempswatrue}{}%
	\IfSubStr{#1}{.png}{\@tempswatrue}{}%
	\IfSubStr{#1}{.PNG}{\@tempswatrue}{}%
	\IfSubStr{#1}{.jpg}{\@tempswatrue}{}%
	\IfSubStr{#1}{.JPG}{\@tempswatrue}{}%
	\IfSubStr{#1}{.jpeg}{\@tempswatrue}{}%
	\IfSubStr{#1}{.JPEG}{\@tempswatrue}{}%
}

% core command!
\DeclareDocumentCommand \initial { O{} m o }{%
	% reset to defaults
	\setcounter{initial@lines}{\value{initialDefaultLines}}%
	\setcounter{initial@depth}{\value{initialDefaultDepth}}%
	\setlength{\initial@hoffset}{\initialDefaultHoffset}%
	\renewcommand*{\initial@hstretch}{\initialDefaultHstretch}%
	\renewcommand*{\initial@vstretch}{\initialDefaultVstretch}%
	\renewcommand*{\initial@scale}{\initialDefaultScale}%
	\setlength{\initial@voffset}{\initialDefaultVoffset}%
	\setlength{\initial@slope}{\initialDefaultSlope}%
	\renewcommand*{\initial@ante}{}%
	\renewcommand*{\initial@anteraw}{}%
	\initial@antehangingfalse
	\initial@antescaledtrue
	\setlength{\initial@GapShift}{0pt}%
	\setlength{\initial@Findent}{\initialDefaultFindent}%
	\setlength{\initial@NindentGap}{\initialDefaultNindent}%
	\setlength{\initial@Nindent}{0pt}%
	\setcounter{initial@afterlines}{\value{initialDefaultAfterlines}}%
	\setlength{\initial@afterindent}{\initialDefaultAfterindent}%
	\setlength{\initial@afterslope}{\initialDefaultAfterslope}%
	\initial@showboxfalse
	\initial@applypresetfalse
	\setcounter{initial@presetdepth}{0}%
	\setcounter{initial@textlines}{0}%
	\setlength{\initial@bclearance}{\initialDefaultBclearance}%
	\setlength{\initial@tclearance}{\initialDefaultTclearance}%
	\ifinitialDefaultBasecap\initial@basecaptrue\else\initial@basecapfalse\fi
	\ifinitialDefaultGrid\initial@gridtrue\else\initial@gridfalse\fi
	\renewcommand*{\initial@actualchar}{}%
	\renewcommand*{\initial@actualtext}{}%
	\edef\initial@color{\initialDefaultColor}%
	\edef\initial@post{\initialDefaultPost}%
	\initial@contourfalse
	\edef\initial@contourcolor{\initialDefaultContourColor}%
	\setlength{\initial@contoursize}{\initialDefaultContourSize}%
	\initial@boldfalse
	\initial@italicfalse
	\initial@smallcapsfalse
	\initial@slantedfalse
	\def\initial@font{}%
	% first pass: apply user keys
	\setkeys{initial}{#1}%
	% build style macro
	\def\initial@charstyle{}%
	\ifinitial@smallcaps \g@addto@macro\initial@charstyle{\scshape}\fi
	\ifinitial@bold      \g@addto@macro\initial@charstyle{\bfseries}\fi
	\ifinitial@italic    \g@addto@macro\initial@charstyle{\itshape}\fi
	\ifinitial@slanted   \g@addto@macro\initial@charstyle{\slshape}\fi
	% apply gap shift
	\addtolength{\initial@Findent}{\initial@GapShift}%
	\addtolength{\initial@NindentGap}{\initial@GapShift}%
	% build content (image or glyph)
	\initial@isimage{#2}%
	\if@tempswa
	\ifdefempty{\initial@actualtext}{%
		\PackageWarning{initial}{no actualtext for image initial.\MessageBreak
			Use actualtext=<letter> for accessibility.\MessageBreak
			Example: \string\initial[actualtext=W]{ornamental-W.pdf}}%
		\def\initial@content{\includegraphics[height=\initial@height]{#2}}%
	}{%
		\def\initial@content{\includegraphics[height=\initial@height,
			actualtext={\initial@actualtext}]{#2}}%
	}%
	\else
	\renewcommand*{\initial@actualchar}{#2}%
	\ifdefempty{\initial@actualtext}{%
		\def\initial@actualtext{#2}%
	}{}%
	\ifinitial@showbox
	\def\initial@content{\initial@boxcap{\initial@applycolor{#2}}}%
	\else
	\def\initial@content{\initial@applycolor{#2}}%
	\fi
	\fi
	% build ante
	\setlength{\initial@scaledantewidth}{0pt}%
	\ifdefempty{\initial@anteraw}{%
		\renewcommand*{\initial@ante}{}%
	}{%
		\ifinitial@antescaled
		\sbox{\@tempboxa}{\initial@scaleante{\initial@anteraw}}%
		\setlength{\initial@scaledantewidth}{\wd\@tempboxa}%
		\renewcommand*{\initial@ante}{\initial@scaleante{\initial@anteraw}}%
		\else
		\sbox{\@tempboxa}{\initial@anteraw}%
		\setlength{\initial@scaledantewidth}{\wd\@tempboxa}%
		\renewcommand*{\initial@ante}{\initial@anteraw}%
		\fi
	}%
	% single-line shortcut
	\ifnum\value{initial@lines}=1\relax
	\par\noindent\initial@ante\initial@content\hskip\the\initial@Findent
	\IfValueT{#3}{\initial@applypost{\initial@post}{#3}}%
	\else
	% prepare sized box
	\sbox{\initial@normalXbox}{X}%
	\sbox{\initial@initialbox}{\scalebox{\initial@hstretch}[\initial@vstretch]{\initial@char\initial@content}}%
	% first line height adjustment
	\@tempdima=\baselineskip
	\setlength{\initial@first}{-\value{initial@lines}\@tempdima}%
	\addtolength{\initial@first}{\@tempdima}%
	\sbox{\@tempboxa}{X}%
	\addtolength{\initial@first}{-\ht\@tempboxa}%
	\addtolength{\initial@first}{\initial@voffset}%
	\addtolength{\initial@first}{\ht\initial@initialbox}%
	\addtolength{\initial@voffset}{-\value{initial@lines}\@tempdima}%
	\addtolength{\initial@voffset}{\@tempdima}%
	\par
	% store box dimensions
	\setlength{\initialboxwidth}{\wd\initial@initialbox}%
	\setlength{\initialboxheight}{\ht\initial@initialbox}%
	\setlength{\initialboxdepth}{\dp\initial@initialbox}%
	
	% calculate bottom space before preset modifies counters
	\@tempdima=0pt\relax
	\ifnum\value{initial@textlines}>0
	\@tempcnta=\value{initial@lines}\relax
	\advance\@tempcnta by \value{initial@depth}\relax
	\advance\@tempcnta by -\value{initial@textlines}\relax
	\ifnum\@tempcnta>0
	\@tempdima=\@tempcnta\baselineskip
	\fi
	\fi
	\advance\@tempdima by \initial@bclearance
	\edef\initial@totalspace{\the\@tempdima}%
	
	% apply preset
	\ifinitial@applypreset
	\newdimen\initial@savedFindent
	\setlength{\initial@savedFindent}{\initial@Findent}%
	\ifcase\value{initial@presettype}
	\or % 1: baseline, in margin
	\setlength{\initial@voffset}{0.0\initialboxheight}%
	\setlength{\initial@NindentGap}{-\initialboxwidth}%
	\addtolength{\initial@NindentGap}{-\initial@hoffset}%
	\or % 2: baseline, into margin
	\setlength{\initial@voffset}{0.0\initialboxheight}%
	\setlength{\initial@hoffset}{-\initialboxwidth}%
	\or % 3: default (deep, in margin)
	\or % 4: deep, into margin
	\setlength{\initial@hoffset}{-\initialboxwidth}%
	\or % 5: hanging, baseline
	\setlength{\initial@voffset}{0.0\initialboxheight}%
	\setlength{\initial@NindentGap}{\initialDefaultFindent}%
	\setcounter{initial@afterlines}{1}%
	\setlength{\initial@afterindent}{\initialboxwidth}%
	\addtolength{\initial@afterindent}{\initial@hoffset}%
	\addtolength{\initial@afterindent}{\initialDefaultFindent}%
	\setlength{\initial@Findent}{\initial@savedFindent}%
	\or % 6: hanging, deep
	\setlength{\initial@NindentGap}{\initialDefaultFindent}%
	\setcounter{initial@afterlines}{1}%
	\setlength{\initial@afterindent}{\initialboxwidth}%
	\addtolength{\initial@afterindent}{\initial@hoffset}%
	\addtolength{\initial@afterindent}{\initialDefaultFindent}%
	\setlength{\initial@Findent}{\initial@savedFindent}%
	\else
	\PackageWarning{initial}{Unknown preset: \arabic{initial@presettype}}%
	\fi
	% second pass: reapply user keys
	\setlength{\initial@GapShift}{0pt}%
	\initial@boldfalse
	\initial@italicfalse
	\initial@smallcapsfalse
	\initial@slantedfalse
	\def\initial@font{}%
	\initial@contourfalse
	\setcounter{initial@presetdepth}{0}%
	\setkeys{initial}{#1}%
	% rebuild style
	\def\initial@charstyle{}%
	\ifinitial@smallcaps \g@addto@macro\initial@charstyle{\scshape}\fi
	\ifinitial@bold      \g@addto@macro\initial@charstyle{\bfseries}\fi
	\ifinitial@italic    \g@addto@macro\initial@charstyle{\itshape}\fi
	\ifinitial@slanted   \g@addto@macro\initial@charstyle{\slshape}\fi
	\addtolength{\initial@Findent}{\initial@GapShift}%
	\addtolength{\initial@NindentGap}{\initial@GapShift}%
	\initial@applypresetfalse
	\fi
	
	% add space above to prevent collision
	\@tempdima=\ht\initial@initialbox
	\advance\@tempdima by \initial@voffset
	\advance\@tempdima by -\baselineskip
	\advance\@tempdima by 0.3\baselineskip
	\advance\@tempdima by \initial@tclearance
	\ifdim\@tempdima>\z@
	\ifinitial@grid
	\@tempcnta=\@tempdima
	\@tempcntb=\baselineskip
	\divide\@tempcnta by \@tempcntb
	\@tempdimb=\@tempcnta\baselineskip
	\ifdim\@tempdimb<\@tempdima
	\advance\@tempcnta by \@ne
	\fi
	\@tempdima=\@tempcnta\baselineskip
	\fi
	\addvspace{\@tempdima}%
	\fi
	
	% calculate indents
	\setlength{\initial@Pindent}{\wd\initial@initialbox}%
	\addtolength{\initial@Pindent}{\initial@hoffset}%
	\ifinitial@antehanging\else
	\addtolength{\initial@Pindent}{\initial@scaledantewidth}%
	\fi
	\addtolength{\initial@Pindent}{\initial@Findent}%
	\setlength{\initial@first}{\linewidth}%
	\addtolength{\initial@first}{-\initial@Pindent}%
	\setlength{\initial@Nindent}{\wd\initial@initialbox}%
	\addtolength{\initial@Nindent}{\initial@hoffset}%
	\ifinitial@antehanging\else
	\addtolength{\initial@Nindent}{\initial@scaledantewidth}%
	\fi
	\addtolength{\initial@Nindent}{\initial@NindentGap}%
	\setlength{\initial@next}{\linewidth}%
	\addtolength{\initial@next}{-\initial@Nindent}%
	% account for right margin
	\addtolength{\initial@Pindent}{\rightmargin}%
	\addtolength{\initial@Nindent}{\rightmargin}%
	% build parshape
	\addtocounter{initial@lines}{\value{initial@depth}}%
	\ifnum\value{initial@afterlines}>0
	\addtocounter{initial@lines}{100}%
	\else
	\addtocounter{initial@lines}{1}%
	\fi
	% region 1: first line
	\edef\initial@parshape{\c@initial@lines \the\initial@Pindent \the\initial@first}%
	% region 2: lines around initial
	\@tempcnta=\tw@
	\@tempcntb=\value{initial@lines}%
	\ifnum\value{initial@afterlines}>0
	\advance\@tempcntb by -99\relax
	\fi
	\@whilenum \@tempcnta<\@tempcntb\do{%
		\addtolength{\initial@Nindent}{\initial@slope}%
		\addtolength{\initial@next}{-\initial@slope}%
		\edef\initial@parshape{\initial@parshape \the\initial@Nindent \the\initial@next}%
		\advance\@tempcnta\@ne
	}%
	% region 3: after-initial lines
	\ifnum\value{initial@afterlines}>0
	\setlength{\initial@after}{\initial@afterindent}%
	\addtolength{\initial@after}{\rightmargin}%
	\setlength{\initial@next}{\linewidth}%
	\addtolength{\initial@next}{-\initial@after}%
	\@tempcntb=1\relax
	\@whilenum \@tempcntb<101\relax\do{%
		\edef\initial@parshape{\initial@parshape \the\initial@after \the\initial@next}%
		\addtolength{\initial@after}{\initial@afterslope}%
		\addtolength{\initial@next}{-\initial@afterslope}%
		\advance\@tempcntb\@ne
	}%
	\else
	\edef\initial@parshape{\initial@parshape \the\rightmargin \the\linewidth}%
	\fi
	% place initial
	\noindent
	\parshape=\initial@parshape\relax
	\smash{%
		\llap{%
			\ifinitial@antehanging
			\ifinitial@antescaled
			\raisebox{\initial@voffset}{\makebox[\initial@scaledantewidth][r]{\initial@ante}\hspace{0.2em}}%
			\else
			\makebox[\initial@scaledantewidth][r]{\initial@ante}\hspace{0.2em}%
			\fi
			\else
			\mbox{\initial@ante}%
			\fi
			\raisebox{\initial@voffset}{\usebox{\initial@initialbox}}%
			\hskip\the\initial@Findent
		}%
	}%
	% output post text
	\IfValueT{#3}{\initial@applypost{\initial@post}{#3}}%
	% automatic spacing via \par redefinition
	\ifdim\initial@totalspace>\z@
	\let\initial@origpar=\par
	\def\par{%
		\initial@origpar
		\vskip\initial@totalspace\relax
		\let\par=\initial@origpar
	}%
	\fi
	\fi
}

\makeatother